{$SAFARNAMA_SITE_ADDRESS::80} {
  encode zstd gzip
  @backend path /api/v1/* /docs /redoc /openapi.json /docs/oauth2-redirect
  handle @backend {
    reverse_proxy backend:8000
  }
  handle {
    root * /srv
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
  }
}
