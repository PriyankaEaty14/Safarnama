#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 1 ]]; then
  echo "Usage: scripts/import_gtfs PATH_TO_GTFS_ZIP" >&2
  exit 2
fi
archive="$(realpath "$1")"
cd "$(dirname "$0")/../backend"
if [[ -e data/safarnama.db || -e data/local_ingestion_report.json ]]; then
  echo "Local database or report exists. For a feed refresh, follow docs/DEPLOYMENT_GUIDE.md." >&2
  exit 1
fi
exec "${SAFARNAMA_PYTHON:-.venv/bin/python}" -m scripts.import_gtfs "$archive" --report data/local_ingestion_report.json
